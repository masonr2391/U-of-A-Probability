/* ==========================================================================
   Grade 11 Early Admission Predictor Stylesheet (styles.css)
   ========================================================================== */

:root {
    --bg-color: #0b1120;
    --card-bg: #1e293b;
    --card-border: #334155;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --accent-sky: #38bdf8;
    --accent-sky-hover: #0284c7;
    --ap-purple: #a855f7;
    --ap-purple-hover: #9333ea;
    --ap-glow: rgba(168, 85, 247, 0.35);
    --success-green: #22c55e;
    --warning-amber: #f59e0b;
    --danger-red: #ef4444;
    --shadow-soft: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
    --radius-lg: 16px;
    --radius-md: 10px;
    --radius-sm: 6px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-primary);
    padding: 2.5rem 1rem;
    display: flex;
    justify-content: center;
    min-height: 100vh;
    line-height: 1.5;
}

.container {
    width: 100%;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
}

/* Header */
.main-header {
    text-align: center;
}

.main-header h1 {
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
}

.main-header p {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 620px;
    margin: 0 auto;
}

/* Card Container */
.card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-soft);
}

.section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
}

.section-title h2 {
    font-size: 1.25rem;
    font-weight: 700;
}

.badge-info {
    background-color: rgba(56, 189, 248, 0.12);
    color: var(--accent-sky);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.section-description {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
}

/* Subject Form Rows */
.subject-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.subject-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(11, 17, 32, 0.6);
    border: 1px solid var(--card-border);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    gap: 1.25rem;
    transition: border-color 0.2s ease;
}

.subject-row:focus-within {
    border-color: var(--accent-sky);
}

.subject-info {
    display: flex;
    flex-direction: column;
    min-width: 170px;
}

.subject-name {
    font-weight: 700;
    font-size: 1.05rem;
    cursor: pointer;
}

.subject-meta {
    font-size: 0.75rem;
    color: var(--text-secondary);
}

/* Controls & Inputs Group */
.controls-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 1;
    justify-content: flex-end;
}

/* Toggle AP Button */
.toggle-btn {
    background-color: var(--card-border);
    color: var(--text-secondary);
    border: none;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.825rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    min-width: 125px;
    text-align: center;
    user-select: none;
}

.toggle-btn:hover {
    background-color: #475569;
    color: var(--text-primary);
}

.toggle-btn.is-ap {
    background-color: var(--ap-purple);
    color: #ffffff;
    box-shadow: 0 0 12px var(--ap-glow);
}

.toggle-btn.is-ap:hover {
    background-color: var(--ap-purple-hover);
}

/* Dual Range Slider + Number Field */
.input-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.grade-slider {
    appearance: none;
    -webkit-appearance: none;
    width: 120px;
    height: 6px;
    border-radius: 3px;
    background: #334155;
    outline: none;
    cursor: pointer;
}

.grade-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-sky);
    cursor: pointer;
    transition: transform 0.15s ease;
}

.grade-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
}

.grade-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.grade-input-wrapper input[type="number"] {
    width: 65px;
    background-color: var(--bg-color);
    border: 1px solid var(--card-border);
    color: var(--text-primary);
    padding: 0.45rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 700;
    text-align: right;
}

.grade-input-wrapper input[type="number"]:focus {
    outline: 2px solid var(--accent-sky);
    border-color: transparent;
}

/* Remove Chrome/Safari/Edge Spinners */
.grade-input-wrapper input::-webkit-outer-spin-button,
.grade-input-wrapper input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

.unit {
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.85rem;
}

/* Results Display Panel */
.results-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.metric-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 0.25rem;
}

.status-title {
    font-size: 1.35rem;
    font-weight: 800;
}

.chance-badge {
    font-size: 2.25rem;
    font-weight: 900;
    padding: 0.35rem 1.25rem;
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.04);
    letter-spacing: -0.02em;
}

/* Status Color Mapping */
.status-strong { color: var(--success-green); }
.status-competitive { color: var(--accent-sky); }
.status-risk { color: var(--warning-amber); }
.status-rejected { color: var(--danger-red); }

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}

.metric-box {
    background-color: rgba(11, 17, 32, 0.5);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 1rem;
}

.metric-value {
    font-size: 1.35rem;
    font-weight: 700;
}

.reason-box {
    background-color: rgba(11, 17, 32, 0.7);
    border-left: 4px solid var(--accent-sky);
    padding: 1rem 1.25rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--text-primary);
}

.reason-box.is-rejected {
    border-left-color: var(--danger-red);
}

/* Action Footer */
.action-footer {
    display: flex;
    justify-content: flex-end;
}

.btn-copy {
    background-color: rgba(56, 189, 248, 0.1);
    color: var(--accent-sky);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-copy:hover {
    background-color: var(--accent-sky);
    color: var(--bg-color);
}

/* Responsive Layout Breakpoints */
@media (max-width: 720px) {
    .subject-row {
        flex-direction: column;
        align-items: flex-start;
    }

    .controls-group {
        width: 100%;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .grade-slider {
        display: none; /* Hide sliders on mobile screens for cleaner layout */
    }
}
