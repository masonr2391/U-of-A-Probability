/* ==========================================================================
   Design System & Master Stylesheet (styles.css)
   Grade 11 Early Admission & 30-AP Fast-Track Predictor
   ========================================================================== */

:root {
    /* Color Palette */
    --bg-primary: #0f172a;
    --bg-card: #1e293b;
    --bg-card-hover: #334155;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    
    /* Accent Colors */
    --accent-blue: #38bdf8;
    --accent-indigo: #6366f1;
    --accent-ap: #a855f7;
    --accent-ap-glow: rgba(168, 85, 247, 0.25);
    
    /* Senior Credit Highlights (Gold/Amber) */
    --accent-senior: #f59e0b;
    --accent-senior-glow: rgba(245, 158, 11, 0.2);
    --border-senior: #d97706;

    /* Status Colors */
    --status-strong: #22c55e;
    --status-strong-bg: rgba(34, 197, 94, 0.15);
    --status-competitive: #3b82f6;
    --status-competitive-bg: rgba(59, 130, 246, 0.15);
    --status-risk: #eab308;
    --status-risk-bg: rgba(234, 179, 8, 0.15);
    --status-rejected: #ef4444;
    --status-rejected-bg: rgba(239, 68, 68, 0.15);

    /* Layout & Borders */
    --border-color: #334155;
    --border-radius-lg: 16px;
    --border-radius-md: 10px;
    --border-radius-sm: 6px;
    --transition-fast: 0.2s ease;
    --transition-smooth: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Base Normalization */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    padding: 2rem 1rem;
    line-height: 1.5;
}

.container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

/* Header Component */
.main-header {
    text-align: center;
    padding: 1rem 0;
}

.main-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
}

.main-header p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 650px;
    margin: 0 auto;
}

/* Main Cards */
.card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: 1.75rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.section-title h2 {
    font-size: 1.35rem;
    font-weight: 700;
}

.section-description {
    color: var(--text-secondary);
    font-size: 0.925rem;
    margin-bottom: 1.75rem;
}

.badge-info {
    background-color: rgba(56, 189, 248, 0.1);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
}

/* Subject Form Rows */
.subject-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.subject-row {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    background-color: rgba(15, 23, 42, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    transition: var(--transition-smooth);
}

.subject-row:hover {
    border-color: #475569;
    background-color: rgba(15, 23, 42, 0.6);
}

/* Fast-Tracked Senior Credit Highlight Styling */
.senior-credit-row {
    border: 1px solid var(--border-senior) !important;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.05) 0%, rgba(30, 41, 59, 0.8) 100%) !important;
    box-shadow: inset 0 0 12px var(--accent-senior-glow);
}

.subject-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.subject-header-tags {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.subject-name {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-primary);
}

.badge-senior {
    background-color: rgba(245, 158, 11, 0.2);
    color: var(--accent-senior);
    border: 1px solid var(--border-senior);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.subject-meta {
    font-size: 0.825rem;
    color: var(--text-muted);
}

/* Controls Layout */
.controls-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
}

@media (max-width: 640px) {
    .controls-group {
        flex-direction: column;
        align-items: stretch;
    }
}

/* AP Toggle Button */
.toggle-btn {
    background-color: var(--bg-primary);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    padding: 0.6rem 1rem;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-fast);
    min-width: 120px;
    text-align: center;
}

.toggle-btn:hover {
    color: var(--text-primary);
    border-color: #64748b;
}

.toggle-btn.is-ap {
    background-color: var(--accent-ap);
    color: #ffffff;
    border-color: var(--accent-ap);
    box-shadow: 0 0 12px var(--accent-ap-glow);
}

/* Range & Input Controls */
.input-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-grow: 1;
}

.grade-slider {
    flex-grow: 1;
    height: 6px;
    background: #334155;
    border-radius: 3px;
    outline: none;
    accent-color: var(--accent-blue);
    cursor: pointer;
}

.senior-slider {
    accent-color: var(--accent-senior) !important;
}

.grade-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.grade-input-wrapper input {
    width: 75px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 0.5rem 1.5rem 0.5rem 0.6rem;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1rem;
    text-align: right;
    outline: none;
    transition: var(--transition-fast);
}

.grade-input-wrapper input:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
}

.grade-input-wrapper .unit {
    position: absolute;
    right: 0.6rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    pointer-events: none;
}

/* Results Panel */
.results-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.25rem;
}

.status-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
}

.chance-badge {
    font-size: 2rem;
    font-weight: 900;
    padding: 0.5rem 1.25rem;
    border-radius: var(--border-radius-md);
    border: 1px solid transparent;
}

/* Status Color Classes */
.status-strong {
    color: var(--status-strong);
    background-color: var(--status-strong-bg);
    border-color: rgba(34, 197, 94, 0.3);
}

.status-competitive {
    color: var(--status-competitive);
    background-color: var(--status-competitive-bg);
    border-color: rgba(59, 130, 246, 0.3);
}

.status-risk {
    color: var(--status-risk);
    background-color: var(--status-risk-bg);
    border-color: rgba(234, 179, 8, 0.3);
}

.status-rejected {
    color: var(--status-rejected);
    background-color: var(--status-rejected-bg);
    border-color: rgba(239, 68, 68, 0.3);
}

/* Detailed Metrics Dashboard Grid */
.metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
}

.metric-box {
    background-color: rgba(15, 23, 42, 0.5);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.metric-label {
    font-size: 0.775rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.metric-value {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
}

/* Assessment Reason Box */
.reason-box {
    background-color: rgba(15, 23, 42, 0.7);
    border-left: 4px solid var(--accent-blue);
    padding: 1rem 1.25rem;
    border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
}

.reason-box.is-rejected {
    border-left-color: var(--status-rejected);
    background-color: rgba(239, 68, 68, 0.05);
}

/* Footer & Actions */
.action-footer {
    display: flex;
    justify-content: flex-end;
}

.btn-copy {
    background-color: var(--bg-card-hover);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.75rem 1.5rem;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: var(--transition-fast);
}

.btn-copy:hover {
    background-color: #475569;
    border-color: #64748b;
}
